<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- สิทธิ์สำหรับระบบพิกัด GPS และการติดตามการออกกำลังกาย -->
    <!-- ขอพิกัดตำแหน่งแบบละเอียด (Fine GPS) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- ขอพิกัดตำแหน่งแบบคร่าวๆ จากเครือข่าย/Wi-Fi (Coarse Location) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- ขอเข้าถึงพิกัดแม้แอปจะทำงานอยู่เบื้องหลัง (Background Location) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- รันเซอร์วิสเบื้องหน้าเพื่อไม่ให้ระบบ Android ปิดการทำงานขณะติดตามกิจกรรม -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- ระบุประเภท Foreground Service สำหรับพิกัดตำแหน่ง (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- ขอสิทธิ์ส่งการแจ้งเตือน (จำเป็นสำหรับ Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ป้องกัน CPU หลับขณะกำลังจับเวลาและบันทึกเส้นทางวิ่ง -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- สิทธิ์เชื่อมต่ออินเทอร์เน็ตสำหรับดาวน์โหลดแผนที่และซิงค์ข้อมูล -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- สิทธิ์สำหรับกล้องถ่ายภาพและการเลือกรูปอาหาร/โปรไฟล์ -->
    <!-- ถ่ายภาพอาหารเพื่อนำไปสแกนวิเคราะห์โภชนาการด้วย AI -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- เข้าถึงคลังภาพสำหรับ Android 12 ลงไป -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- เข้าถึงคลังภาพสำหรับ Android 13 ขึ้นไป (Photo Picker) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- สิทธิ์ยืนยันตัวตนด้วยชีวมิติ (Biometrics: สแกนนิ้วมือ/ใบหน้า) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- สิทธิ์สำหรับการแจ้งเตือนและการตั้งเวลาปลุกเตือนกิจวัตร -->
    <!-- รับสัญญาณเมื่ออุปกรณ์เปิดเครื่องใหม่ เพื่อคืนค่าเวลาแจ้งเตือนที่เคยตั้งไว้ -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- สิทธิ์สั่นเตือนบนอุปกรณ์ -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- สิทธิ์ตั้งเวลาเตือนกิจวัตรแบบแม่นยำตรงเวลา (Exact Alarm สำหรับ Android 12+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:label="healthymate"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- ธีมหน้าต่างตอนเริ่มเปิดแอป (Splash Screen) -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- จุดเริ่มต้นหลักในการรันแอปพลิเคชันจากหน้า Launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Deep Link Intent Filter สำหรับ Supabase Auth / Google OAuth Callback -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.example.healthymate" android:host="login-callback" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="io.supabase.healthymate" />
            </intent-filter>
        </activity>

        <!-- Receiver สำหรับคืนค่าการแจ้งเตือนเมื่อเปิดเครื่องใหม่หรืออัปเดตแอป (ต้อง exported=true เพื่อให้ Android OS ส่งสัญญาณเข้ามาได้) -->
        <receiver android:exported="true" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Receiver สำหรับสั่งยิง Local Notification เมื่อถึงเวลาที่ตั้งไว้ -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>

        <!-- Flutter V2 Embedding -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Google Maps API Key สำหรับแสดงผลแผนที่และคำนวณเส้นทาง -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${googleMapsApiKey}" />

        <!-- Background Service ติดตามพิกัดตำแหน่ง GPS ขณะออกกำลังกายในเบื้องหลัง -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            android:foregroundServiceType="location"
            android:exported="true" />
    </application>

    <!-- สำหรับรองรับการประมวลผลข้อความบน Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
